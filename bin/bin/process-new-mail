#!/bin/zsh

# Commit the Maildir to git after each offlineimap sync (postsynchook).
# Spam filtering happens on the server (rspamd-imap), not here.

# Use flock to prevent concurrent git operations
(
  flock -x 9 || exit 1
  cd ~/Maildir/ || exit 1
  if ! git rev-parse --verify -q HEAD >/dev/null; then
    notify-send -u critical "Maildir git repo is broken" "Run git fsck in ~/Maildir"
    exit 1
  fi
  git add -A
  git diff --cached --quiet || git commit -q -m "Automated commit: $(date)" \
    || notify-send -u critical "Maildir git commit failed"
) 9>/tmp/maildir-git.lock
